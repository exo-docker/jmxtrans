{
  "servers" : [ {
    "port" : "${TARGET_JMX_PORT}",
    "host" : "${TARGET_JMX_HOST}",
    "username" : "${TARGET_JMX_USER}",
    "password" : "${TARGET_JMX_PASSWORD}",
    "queries" : [ {
      "outputWriters" : [ {
        "@class" : "com.googlecode.jmxtrans.model.output.GraphiteWriterFactory",
        "host" : "${TARGET_GRAPHITE_HOST}",
        "port" : "${TARGET_GRAPHITE_PORT}",
        "rootPrefix" : "${TARGET_GRAPHITE_ROOT_PREFIX}",
        "typeNames" : []
      } ],
      "obj" : "java.lang:type=OperatingSystem",
      "resultAlias" : "jvm_system",
      "attr" : ["SystemLoadAverage","AvailableProcessors","TotalPhysicalMemorySize","FreePhysicalMemorySize","TotalSwapSpaceSize","FreeSwapSpaceSize","OpenFileDescriptorCount","MaxFileDescriptorCount"]
    } ]
  } ]
}
