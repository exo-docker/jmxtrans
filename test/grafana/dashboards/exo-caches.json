  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "exo-influxdb"
        },
        "query": "SHOW TAG VALUES FROM \"jvm_memory_heap\" WITH KEY = \"host\"",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "sort": 1
      },
      {
        "name": "cache",
        "label": "Cache",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "exo-influxdb"
        },
        "query": "SHOW TAG VALUES FROM \"exo_cache\" WITH KEY = \"typeName\" WHERE \"host\" =~ /^$host$/",
        "regex": "/(?<value>.*name=\"?(?<text>[^\",]+)\"?)$/",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "sort": 1
      }
    ]
  },
