  "panels": [
    {
      "type": "stat",
      "title": "Heap used",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "exo-influxdb"
          },
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"HeapMemoryUsage_used\") * 100.0 / last(\"HeapMemoryUsage_max\") FROM \"jvm_memory_heap\" WHERE \"host\" =~ /^$host$/ AND time > now() - 5m",
          "alias": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "id": 1,
      "datasource": {
        "type": "influxdb",
        "uid": "exo-influxdb"
