    {
      "type": "timeseries",
      "title": "Heap used (%) per host",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "exo-influxdb"
          },
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"HeapMemoryUsage_used\") * 100.0 / mean(\"HeapMemoryUsage_max\") FROM \"jvm_memory_heap\" WHERE \"host\" =~ /^$host$/ AND $timeFilter GROUP BY time($__interval), \"host\" fill(null)",
          "alias": "$tag_host"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "transformations": [],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
