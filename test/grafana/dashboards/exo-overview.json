          "query": "SELECT non_negative_derivative(mean(\"requestCount\"), 1s) FROM \"tomcat_request_processor\" WHERE \"host\" =~ /^$host$/ AND $timeFilter GROUP BY time($__interval), \"host\" fill(null)",
          "alias": "$tag_host"
