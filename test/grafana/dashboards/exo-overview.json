{
  "uid": "exo-overview",
  "title": "eXo - Overview",
  "tags": [
    "exo",
    "overview"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "bargauge",
      "title": "Heap used (%)",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "exo-influxdb"
          },
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"HeapMemoryUsage_used\") * 100.0 / last(\"HeapMemoryUsage_max\") FROM \"jvm_memory_heap\" WHERE \"host\" =~ /^$host$/ AND time > now() - 5m GROUP BY \"host\"",
          "alias": "$tag_host"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 1,
      "datasource": {
        "type": "influxdb",
        "uid": "exo-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "transformations": []
    },
