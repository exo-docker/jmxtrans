{
  "uid": "exo-database",
  "title": "eXo - Database pools",
  "tags": [
    "exo",
    "database"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "bargauge",
      "title": "Pool usage now (%)",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "exo-influxdb"
          },
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT last(\"numActive\") * 100.0 / last(\"maxActive\") FROM \"tomcat_datasources\" WHERE \"host\" =~ /^$host$/ AND time > now() - 5m GROUP BY \"typeName\"",
          "alias": "$tag_typeName"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 1,
      "datasource": {
        "type": "influxdb",
        "uid": "exo-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*name=\"?([^\",]+)\"?.*",
            "renamePattern": "$1"
          }
        }
      ]
    },
