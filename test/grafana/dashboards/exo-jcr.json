  "panels": [
    {
      "type": "timeseries",
      "title": "Hit ratio",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "exo-influxdb"
          },
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"hitRatio\") FROM \"exo_infinispan_jcr\" WHERE \"host\" =~ /^$host$/ AND $timeFilter  GROUP BY time($__interval), \"typeName\" fill(null)",
          "alias": "$tag_typeName"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*name=\"?([^\",]+)\"?.*",
            "renamePattern": "$1"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
